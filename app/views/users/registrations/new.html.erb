<h2>Sign up</h2>

<%= form_for(resource, as: resource_name, url: registration_path(resource_name)) do |f| %>
  <%= render "users/shared/error_messages", resource: resource %>

  <p><%= f.label :name %><br><%= f.text_field :name, autofocus: true, required: true %></p>
  <p><%= f.label :email %><br><%= f.email_field :email, autocomplete: "email", required: true %></p>
  <p><%= f.label :address %><br><%= f.text_field :address %></p>
  <p><%= f.label :city %><br><%= f.text_field :city %></p>
  <p><%= f.label :postal_code %><br><%= f.text_field :postal_code, placeholder: "R3B 0Y2" %></p>
  <p><%= f.label :province_id, "Province" %><br><%= f.collection_select :province_id, Province.order(:name), :id, :name, include_blank: "Select Province" %></p>

  <p>
    <%= f.label :password %>
    <% if @minimum_password_length %><em>(<%= @minimum_password_length %> characters minimum)</em><% end %><br>
    <%= f.password_field :password, autocomplete: "new-password", required: true %>
  </p>

  <p><%= f.label :password_confirmation %><br><%= f.password_field :password_confirmation, autocomplete: "new-password", required: true %></p>

  <p><%= f.submit "Sign up" %></p>
<% end %>

<%= render "users/shared/links" %>