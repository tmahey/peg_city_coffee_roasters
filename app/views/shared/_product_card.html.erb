<div style="border: 1px solid #ddd; padding: 16px; margin-bottom: 16px;">
  <div style="display: flex; justify-content: space-between; align-items: center;">
    <small><%= product.category.name %></small>
    <% if product.on_sale? %>
      <span style="background: #c00; color: white; font-size: 11px; font-weight: bold; padding: 2px 8px; border-radius: 4px;">ON SALE</span>
    <% end %>
  </div>
  <h3><%= link_to product.title, product_path(product) %></h3>
  <p><%= truncate(product.description, length: 100) %></p>
  <p>
    <% if product.on_sale? && product.sale_price.present? %>
      <span style="color: #888; text-decoration: line-through;"><%= number_to_currency(product.price) %></span>
      <strong style="color: #c00;"><%= number_to_currency(product.sale_price) %></strong>
    <% else %>
      <strong><%= number_to_currency(product.price) %></strong>
    <% end %>
  </p>
  <%= button_to "Add to Cart", add_to_cart_path(product_id: product.id), method: :post %>
</div>
