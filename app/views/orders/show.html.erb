<h1>Order <%= @order.id %> (<%= @order.status.upcase %>)</h1>
<p>Placed on <%= @order.created_at.strftime("%B %d, %Y") %></p>

<table border="1" cellpadding="8" cellspacing="0" width="100%">
  <thead>
    <tr><th>Product</th><th>Qty</th><th>Price</th><th>Line Total</th></tr>
  </thead>
  <tbody>
    <% @order.order_items.each do |item| %>
      <tr>
        <td><%= item.product.title %></td>
        <td><%= item.quantity %></td>
        <td><%= number_to_currency(item.price_at_purchase) %></td>
        <td><%= number_to_currency(item.price_at_purchase * item.quantity) %></td>
      </tr>
    <% end %>
  </tbody>
</table>

<p>Subtotal: <%= number_to_currency(@order.subtotal) %></p>
<p>GST: <%= number_to_currency(@order.gst_amount) %></p>
<p>PST: <%= number_to_currency(@order.pst_amount) %></p>
<p>HST: <%= number_to_currency(@order.hst_amount) %></p>
<h3>Grand Total: <%= number_to_currency(@order.total_price) %></h3>

<p><%= link_to "Back to My Orders", orders_path %></p>